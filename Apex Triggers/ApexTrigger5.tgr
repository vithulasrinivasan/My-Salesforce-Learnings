trigger ApexTrigger5 on Opportunity (before insert) {
	//validation - written in the before triggers
	
    for(Opportunity oldOpp: Trigger.old){
        for(Opportunity newOpp: Trigger.new){
            if(oldOpp.id == newOpp.id && oldOpp.Amount != newOpp.Amount)
                newOpp.Amount.addError('Amount cannot be changed'); //Trigger Exception - here error shown on the field
            	//newOpp.addError('Amount cannot be changed'); //Trigger Exception - here error shown on the record
            	//error is the only thing you can show onto the UI with the apex code
            	
        }        
    }
}