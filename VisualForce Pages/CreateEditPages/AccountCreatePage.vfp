<apex:page standardController="Account" extensions="LeadExtension,StudentExtension" sidebar="false">
    <apex:form >
        <apex:pageBlock title="Account Create & Edit Page">
            <apex:pageBlockSection >
                <apex:inputField value="{!Account.Name}"/>
                <apex:inputField value="{!Account.NumberOfEmployees}"/>
                <apex:inputField value="{!Account.Rating}"/>
                <apex:inputField value="{!Account.Type}"/>
            </apex:pageBlockSection>
            
            <apex:pageBlockButtons location="BOTTOM">
            	<apex:commandButton action="{!Save}" value="Save the Record"/>
        	</apex:pageBlockButtons>
        </apex:pageBlock>
        
    <apex:pageBlock >
        <apex:pageBlockTable value="{!llist}" var="l">
            
            <apex:column value="{!l.Name}"/>
            <apex:column value="{!l.Status}"/>
            
        </apex:pageBlockTable>
        
    </apex:pageBlock> 
        
    <apex:pageBlock >
        <apex:pageBlockTable value="{!stlist}" var="st">
            
            <apex:column value="{!st.Name}"/>
            <apex:column value="{!st.Student_Name__c}"/>
            
        </apex:pageBlockTable>
        
    </apex:pageBlock> 
    </apex:form>
</apex:page>
