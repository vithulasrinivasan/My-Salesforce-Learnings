<apex:page controller="FirstController" extensions="LeadExtension">
    <apex:form >
        
        <apex:tabPanel>
            
            <apex:tab label="first tab">
        
        <apex:pageBlock title="Account, Contact & Opportunity Create Page">
            
            <apex:pageBlockSection title="Account Information">
                <apex:outputLabel value="Account Name"/>
                <apex:inputText value="{!accName}"/>
                
                <apex:outputLabel value="Number Of Employees"/>
                <apex:inputText value="{!accEmployees}"/>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Contact Information">
                <apex:outputLabel value="Contact Name"/>
                <apex:inputText value="{!conName}"/>
                
                <apex:outputLabel value="Contact Email"/>
                <apex:inputText value="{!conEmail}"/>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Opportunity Information">
                <apex:outputLabel value="Opportunity Name"/>
                <apex:inputText value="{!oppName}"/>
                
                <apex:outputLabel value="Opportunity Amount"/>
                <apex:inputText value="{!oppAmount}"/>
            </apex:pageBlockSection>
            
            <apex:pageBlockButtons >
                <apex:commandButton action="{!saveTheRecord}" value="Save all three of them"/>
            </apex:pageBlockButtons>
                
        </apex:pageBlock>
        
                </apex:tab>
            
		<apex:tab label="second tab">            
        <apex:pageBlock >
            <apex:pageBlockTable value="{!llist}" var="l">
                <apex:column value="{!l.Name}"/>
                <apex:column value="{!l.Status}"/>
            </apex:pageBlockTable>
        </apex:pageBlock>
            
            </apex:tab>
    
        </apex:tabPanel>
    </apex:form>
</apex:page>
